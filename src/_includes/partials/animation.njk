{#- A looping animation in a note, placed after its first paragraph by layouts/note.njk.
    The files and caption come from the note's .11tydata.js file. It plays muted, unless the
    reader has asked for less motion, and the button pauses and plays it. -#}
<figure class="anim">
  <video id="anim-video" width="{{ animation.width }}" height="{{ animation.height }}" muted loop playsinline preload="none" poster="{{ animation.poster }}" aria-describedby="anim-cap">
    <source src="{{ animation.video }}" type="video/mp4">
  </video>
  <figcaption id="anim-cap">{{ animation.caption }} <button type="button" class="anim-toggle" id="anim-toggle" hidden>Play</button></figcaption>
</figure>
