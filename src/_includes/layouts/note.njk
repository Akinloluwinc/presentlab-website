---
layout: layouts/base.njk
---
{%- from "partials/note-row.njk" import noteRow -%}
{%- from "partials/film.njk" import film -%}
{%- set shownFilms = films | filmsToShow(site.preview) -%}
{%- set practiceInfo = practice | practice -%}
{%- set typeName = type | typeLabel -%}
{#- A looping animation, when the note's .11tydata.js file sets one, goes after the first paragraph. -#}
{%- if animation and animation.video -%}
{%- set animationFigure %}{% include "partials/animation.njk" %}{% endset -%}
{%- set content = content | afterFirstParagraph(animationFigure) -%}
{%- endif %}
<article class="wrap entry" aria-labelledby="h-entry">
  <div class="grid">
    <p class="crumb"><a class="tl" href="/notes/">Notes</a><span aria-hidden="true">/</span><em>{{ typeName }}</em></p>
    <h1 id="h-entry">{{ title }}</h1>
    <p class="dek">{{ dek }}</p>
  </div>
  {%- if shownFilms.length %}
  <div class="grid film-row">
    {{ film(shownFilms[0], true, "film-1") }}
  </div>
  {%- endif %}
  <div class="grid entry-body">
    <dl class="facts">
      {%- if type == 'event' %}
      <div><dt>When</dt><dd><time datetime="{{ page.date | isoDate }}">{{ page.date | weekday }} {{ page.date | fullDate }}</time>{% if time %}<span class="l2">{{ time }}</span>{% else %}<span class="tbc">Time to follow</span>{% endif %}</dd></div>
      {%- if place %}
      <div><dt>Where</dt><dd>{{ place }}</dd></div>
      {%- endif %}
      {%- if capacity %}
      <div><dt>Places</dt><dd>{{ capacity }}</dd></div>
      {%- endif %}
      <div><dt>Reserve</dt><dd>{% if reserve %}{{ reserve | reserveLink | safe }}{% else %}<span class="tbc">Details to follow</span>{% endif %}</dd></div>
      {%- if hosts %}
      <div><dt>Hosts</dt><dd>{{ hosts }}</dd></div>
      {%- endif %}
      {%- else %}
      <div><dt>Published</dt><dd><time datetime="{{ page.date | isoMonth }}">{{ page.date | monthYear }}</time></dd></div>
      {%- if version %}
      <div><dt>Version</dt><dd>{{ version }}</dd></div>
      {%- endif %}
      {%- if authors %}
      <div><dt>Authors</dt><dd>{{ authors }}</dd></div>
      {%- endif %}
      {%- if commissioned_by %}
      <div><dt>Commissioned by</dt><dd>{{ commissioned_by }}</dd></div>
      {%- endif %}
      {%- if app %}
      <div><dt>Runs at</dt><dd><a href="{{ app }}">{{ app | replace("https://", "") }}</a></dd></div>
      {%- endif %}
      {%- if demo %}
      <div><dt>Try it</dt><dd><a href="{{ demo }}">Explore the synthetic demo</a></dd></div>
      {%- endif %}
      {%- if shownFilms.length %}
      <div><dt>Films</dt><dd>
        {%- for f in shownFilms %}<span class="l2">{% if f.video or f.url %}<a href="#film-{{ loop.index }}" data-film-jump="film-{{ loop.index }}">{{ f.title }}</a>{% else %}{{ f.title }}{% endif %} <span class="fsize">({{ f.length }})</span></span>{% endfor -%}
      </dd></div>
      {%- endif %}
      {%- if file or link %}
      <div><dt>Read it</dt><dd>
        {%- if file %}{% set size = file | fileSize %}<span class="l2"><a href="{{ file }}">Download the PDF</a>{% if size %} <span class="fsize">({{ size }})</span>{% endif %}</span>{% endif %}
        {%- if link %}<span class="l2"><a href="{{ link }}">Read online</a></span>{% endif -%}
      </dd></div>
      {%- endif %}
      {%- if extraFacts and extraFacts.length %}
      {%- for item in extraFacts %}
      <div><dt>{{ item.label }}</dt><dd>
        {%- if item.file %}{% set size = item.file | fileSize %}<span class="l2"><a href="{{ item.file }}">{{ item.linkText or 'Download the PDF' }}</a>{% if size %} <span class="fsize">({{ size }})</span>{% endif %}</span>
        {%- elif item.href %}<span class="l2"><a href="{{ item.href }}">{{ item.linkText }}</a>{% if item.meta %} <span class="fsize">({{ item.meta }})</span>{% endif %}</span>
        {%- elif item.text %}{{ item.text }}{% endif %}
        {%- if item.note %}<span class="tbc">{{ item.note }}</span>{% endif -%}
      </dd></div>
      {%- endfor %}
      {%- endif %}
      {%- endif %}
    </dl>
    <div class="prose">
      {{ content | safe }}
      {%- if shownFilms.length > 1 %}
      {%- set guides = shownFilms.length - 1 %}
      <h2>How it works, in {{ "one guide" if guides == 1 else ("two guides" if guides == 2 else guides ~ " guides") }}</h2>
      {%- for f in shownFilms %}{% if not loop.first %}
      {{ film(f, false, "film-" ~ loop.index) }}
      {%- endif %}{% endfor %}
      {%- endif %}
      {%- if practiceInfo %}
      <p class="filed">Filed under <a class="tl" href="{{ practiceInfo.url }}">{{ practiceInfo.name }}</a></p>
      {%- endif %}
    </div>
  </div>
</article>

{%- set more = collections.notes | others(page.url) %}
{%- if more.length %}
<section class="wrap sec more" aria-labelledby="h-more">
  <div class="grid opener">
    <h2 id="h-more" class="h2">More notes</h2>
  </div>
  <ol class="nlist">
    {%- for note in more %}
    {{ noteRow(note) }}
    {%- endfor %}
  </ol>
  <p class="after"><a class="tl" href="/notes/">All notes</a></p>
</section>
{%- endif %}

<p class="wrap ask">To ask about anything here, write to <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
