---
permalink: /notes/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <title>{{ site.name }} — Notes</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <link href="{{ site.url }}/notes/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/notes/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/notes/</id>
  {%- if collections.notes.length %}
  <updated>{{ collections.notes[0].date | isoDateTime }}</updated>
  {%- endif %}
  <author>
    <name>{{ site.name }}</name>
    <email>{{ site.email }}</email>
    <uri>{{ site.url }}/</uri>
  </author>
  {%- for note in collections.notes %}
  <entry>
    <title>{{ note.data.title }}</title>
    <link href="{{ site.url }}{{ note.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ note.url }}</id>
    <updated>{{ note.date | isoDateTime }}</updated>
    <category term="{{ note.data.type }}" label="{{ note.data.type | typeLabel }}"/>
    {%- if note.data.authors %}
    <author><name>{{ note.data.authors }}</name></author>
    {%- endif %}
    <summary>{{ note.data.dek }}</summary>
    <content type="html">{{ note.templateContent | absUrls }}</content>
  </entry>
  {%- endfor %}
</feed>
